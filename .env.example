# Overrides for `docker compose up`. Copy to .env in the repository root.
# Every value is optional: compose.yaml has development-only fallbacks for
# each one. Never use those fallbacks outside your own machine.
#
# backend/.env is a different file. It configures pytest and runserver
# against Postgres.app and is not read by Compose.

SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
DEBUG=true
POSTGRES_DB=applications_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
